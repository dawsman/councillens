{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CouncilLens topic model",
  "description": "The contract for one council + one topic, written by the analyse stage to data/analysed/<council-slug>/<topic-slug>.json and read by the publish stage. Strict: unknown fields are rejected, so a council-specific field cannot leak into the site.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "council", "topic", "sources", "events", "linkages", "gaps", "corrections_url"],
  "$defs": {
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ids", "prompt_version", "model", "confidence", "review_status", "reviewed_by", "generated_at", "cache_key"],
      "properties": {
        "source_ids": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Canonical record ids this output was derived from."
        },
        "prompt_version": {"type": "string"},
        "model": {"type": "string"},
        "confidence": {"enum": ["high", "medium", "low"]},
        "review_status": {"enum": ["needs_review", "ai_reviewed", "reviewed"], "description": "needs_review: unchecked. ai_reviewed: independently checked against the source documents by a second AI pass, not yet by a person. reviewed: checked by a person."},
        "reviewed_by": {
          "type": ["string", "null"],
          "description": "Who checked it: a person's name or handle, or a description of the AI review pass; null until checked."
        },
        "generated_at": {"type": "string", "format": "date-time"},
        "cache_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 over the item key, the source sha256s and the prompt version. See src/analyse/README.md."
        }
      }
    },
    "date_string": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "description": "YYYY, YYYY-MM or YYYY-MM-DD. Null when the record gives no date at all."
    }
  },
  "properties": {
    "schema_version": {"const": "1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "council": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "slug", "website", "tier", "remit_note", "platforms"],
      "properties": {
        "name": {"type": "string"},
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "website": {"type": "string", "format": "uri"},
        "tier": {"enum": ["district", "county", "unitary", "metropolitan", "combined", "parish", "unknown"]},
        "remit_note": {
          "type": "string",
          "description": "Plain-English note on what this council does and does not control."
        },
        "platforms": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "description": "Role -> platform, e.g. committees: cmis."
        }
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "slug", "plain_english", "questions"],
      "properties": {
        "name": {"type": "string"},
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "plain_english": {"type": "string"},
        "questions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["asked", "decided", "done"],
          "properties": {
            "asked": {"type": "string"},
            "decided": {"type": "string"},
            "done": {"type": "string"}
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "type", "stage", "body", "platform", "source_url", "fetched_at", "sha256", "saved_to", "summary", "ai"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "type": {"enum": ["agenda", "minutes", "consultation", "feedback", "spending", "performance", "policy", "unknown"]},
          "stage": {"enum": ["feedback", "decision", "outcome", null]},
          "body": {"type": ["string", "null"]},
          "platform": {"enum": ["cmis", "modern_gov", "localgov_drupal", "citizen_space", "commonplace", "engagement_hq", "engagement", "generic"]},
          "source_url": {"type": "string", "format": "uri"},
          "fetched_at": {"type": "string", "format": "date-time"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "saved_to": {"type": "string"},
          "summary": {"type": "string"},
          "ai": {"$ref": "#/$defs/ai"}
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stage", "date", "date_precision", "title", "summary", "detail", "source_ids", "source_url", "status", "ai"],
        "properties": {
          "id": {"type": "string", "pattern": "^evt-[a-z0-9-]+$"},
          "stage": {"enum": ["feedback", "decision", "outcome"]},
          "date": {"$ref": "#/$defs/date_string"},
          "date_precision": {"enum": ["day", "month", "year", "unknown"]},
          "title": {"type": "string"},
          "summary": {"type": "string"},
          "detail": {"type": "array", "items": {"type": "string"}},
          "source_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "source_url": {"type": "string", "format": "uri"},
          "status": {
            "enum": ["done", "in_progress", "still_waiting", "unknown", null],
            "description": "Carried on outcome events. Null on feedback and decision events."
          },
          "ai": {"$ref": "#/$defs/ai"}
        }
      }
    },
    "linkages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_event", "to_event", "tier", "evidence", "evidence_url", "explanation", "ai"],
        "properties": {
          "from_event": {"type": "string", "pattern": "^evt-[a-z0-9-]+$"},
          "to_event": {"type": "string", "pattern": "^evt-[a-z0-9-]+$"},
          "tier": {
            "enum": ["confirmed", "possible", "none"],
            "description": "confirmed only where the council's own record cites the feedback."
          },
          "evidence": {
            "type": ["string", "null"],
            "description": "Verbatim quote from the council record, or null."
          },
          "evidence_url": {"type": ["string", "null"], "format": "uri"},
          "explanation": {"type": "string"},
          "ai": {"$ref": "#/$defs/ai"}
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "description"],
        "properties": {
          "stage": {"enum": ["feedback", "decision", "outcome", null]},
          "description": {"type": "string"}
        }
      }
    },
    "corrections_url": {"type": "string", "format": "uri"}
  }
}
